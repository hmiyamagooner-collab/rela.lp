# RELA LP / Stripe Webhook 用の環境変数テンプレート
# 実際の値は .env* には置かず、Vercelプロジェクト(rela-lp)の Environment Variables に設定する。
# （.gitignore で .env* は除外済み。シークレットは絶対にコミットしない）

# --- Stripe ---
# テスト時は sk_test_... / whsec_...(テスト用) 、本番は sk_live_... / 本番Webhookのwhsec_...
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Supabase (本番: xmuvgobfompdwhgxnpis) ---
SUPABASE_URL=https://xmuvgobfompdwhgxnpis.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- price(Stripe Price ID) → plan 対応 ---
# 各サブスク商品の Price ID(price_xxx)。Payment Link URL ではないので注意。
PRICE_BASIC=
PRICE_STANDARD=
PRICE_PREMIUM=
